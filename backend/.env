# Copy this to .env and fill in your values
# Do NOT commit .env to git

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+15551234567

# Comma-separated E.164 phone numbers to alert (ATC, ops center, etc.)
ALERT_RECIPIENTS=+919876543210,+919876543211

# Optional: Slack incoming webhook, PagerDuty, or custom endpoint
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx
